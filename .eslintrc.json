{
  "extends": "@adobe/eslint-config-aio-lib-config",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "ignorePatterns": ["node_modules/", "dist/"],
  "rules": {
    "node/no-unpublished-require": [
      "error",
      {
        "allowModules": ["minimatch", "recursive-readdir"]
      }
    ]
  }
}