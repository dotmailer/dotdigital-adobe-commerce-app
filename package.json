{
  "name": "dotdigital-commerce-app",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Dotdigital app for Adobe Commerce",
  "author": "Dotdigital",
  "dependencies": {
    "@adobe/aio-cli": "^10.3.2",
    "@adobe/aio-lib-ims": "^8.1.0",
    "@adobe/aio-sdk": "^6",
    "dotenv": "^17.0.1",
    "got": "^11.8.5",
    "js-yaml": "^4.1.0",
    "oauth-1.0a": "^2.2.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@adobe/eslint-config-aio-lib-config": "^4.0.0",
    "@types/jest": "^30.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-jest": "^27.0.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.0.4",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.3",
    "prettier": "^3.6.2",
    "recursive-readdir": "^2.2.3"
  },
  "scripts": {
    "dotdigital-pack": "node scripts/pack/pre-pack.js",
    "lint:check": "npx eslint .",
    "lint:fix": "npm run lint:check -- --fix",
    "format:check": "npx prettier . --check",
    "format:fix": "npm run format:check -- --write",
    "code-check": "npm run lint:check",
    "code-fix": "npm run format:fix && npm run lint:fix",
    "configure-events": "node -e \"require('./scripts/configure-events').main()\"",
    "configure-commerce-events": "aio console workspace download ws.json && node -e \"require('./scripts/configure-commerce-events').main('ws.json')\"; rm -f ws.json"
  },
  "engines": {
    "node": ">=22"
  },
  "aio-app-builder-templates": [
    "@adobe/generator-app-events-generic",
    "@adobe/generator-add-action-generic",
    "@adobe/generator-add-events-generic",
    "@adobe/generator-add-web-assets-exc-react"
  ]
}
