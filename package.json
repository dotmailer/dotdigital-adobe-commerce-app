  "description": "An Adobe Commerce app",
  "author": "Dotdigital",
  "dependencies": {
    "@adobe/aio-lib-ims": "^8.0.1",
    "@adobe/aio-sdk": "^6.0.0",
    "dotenv": "^16.4.5",
    "got": "^11.8.5",
    "node-fetch": "^3.3.2",
    "oauth-1.0a": "^2.2.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@adobe/eslint-config-aio-lib-config": "^4.0.0",
    "eslint-config-standard": "^17.1.0",
    "jest": "^29.7.0"
  },
  "scripts": {
    "test": "jest --passWithNoTests -c ./test/jest.config.js ./test",
    "e2e": "jest --collectCoverage=false --testRegex ./e2e",
